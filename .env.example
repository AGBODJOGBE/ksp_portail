# Copier en .env.local pour le développement (jamais de vrai secret dans ce fichier).

# Adresse publique du site (liens absolus, plan du site, partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Gateway appelée par le navigateur. En production : https://api.ksp.bj
NEXT_PUBLIC_API_URL=http://localhost:3000

# Gateway appelée par le serveur Next.js (rendu des pages publiques).
# En production : adresse interne du cluster ; par défaut, la même que NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Origine du stockage des fichiers (adresses présignées du service file), autorisée par la CSP pour
# l'envoi des photos du Nettoyage. Vide : envoi refusé. À fournir par environnement (à valider).
NEXT_PUBLIC_FILE_STORAGE_ORIGIN=

# Numéro WhatsApp du bouton de contact, format international sans « + » (à fournir), par exemple 2290197000045.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Coordonnées de la page Contact (à fournir). Vides : la page affiche des valeurs d'exemple
# signalées comme telles (src/config/contact.ts).
# Téléphone au format international (Bénin : 10 chiffres) : +2290197000045
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Adresses des autres sites de l'écosystème (liens croisés).
NEXT_PUBLIC_PORTAIL_URL=http://localhost:3010
NEXT_PUBLIC_SHOP_URL=http://localhost:3020
NEXT_PUBLIC_PRINT_URL=http://localhost:3030
